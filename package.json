{
  "name": "ethereum-wallet-generator",
  "version": "1.0.0",
  "description": "A CLI tool to generate Ethereum blockchain wallets with address, private key, and 24-word mnemonic phrase",
  "main": "index.js",
  "type": "module",
  "author": {
    "name": "Piotr Kowalski",
    "email": "piecioshka@gmail.com",
    "url": "https://piecioshka.pl/"
  },
  "license": "MIT",
  "types": "types/index.d.ts",
  "exports": {
    ".": {
      "types": "./types/index.d.ts",
      "import": "./index.js"
    }
  },
  "scripts": {
    "start": "node bin/cli.js",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "node bin/cli.js --json > /dev/null && node bin/cli.js --version && node bin/cli.js --help > /dev/null",
    "lint": "eslint .",
    "prepare": "husky"
  },
  "dependencies": {
    "ethers": "^6.13.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "eslint": "^10.8.0",
    "globals": "^17.9.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.3.0",
    "prettier": "^3.9.6"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "bin": {
    "ethereum-wallet-generator": "bin/cli.js",
    "eth-wallet": "bin/cli.js"
  },
  "files": [
    "index.js",
    "bin/",
    "types/",
    "package.json",
    "LICENSE",
    "README.md"
  ],
  "lint-staged": {
    "*.{js,mjs}": [
      "prettier --write",
      "eslint --fix"
    ],
    "*.{json,md,yml,ts}": [
      "prettier --write"
    ]
  },
  "keywords": [
    "ethereum",
    "wallet",
    "blockchain",
    "crypto",
    "cryptocurrency",
    "eth",
    "web3",
    "mnemonic",
    "bip39",
    "private-key",
    "address",
    "generator",
    "cli"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/piecioshka/ethereum-wallet-generator.git"
  },
  "bugs": {
    "url": "https://github.com/piecioshka/ethereum-wallet-generator/issues"
  },
  "homepage": "https://github.com/piecioshka/ethereum-wallet-generator#readme"
}
