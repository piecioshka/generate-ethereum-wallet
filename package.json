{
  "name": "ethereum-wallet-generator",
  "version": "1.0.0",
  "description": "A CLI tool to generate Ethereum blockchain wallets with address, private key, and 24-word mnemonic phrase",
  "main": "index.js",
  "type": "module",
  "exports": {
    ".": {
      "import": "./index.js"
    }
  },
  "dependencies": {
    "ethers": "^6.13.0"
  },
  "bin": {
    "ethereum-wallet-generator": "bin/cli.js",
    "eth-wallet": "bin/cli.js"
  },
  "files": [
    "index.js",
    "bin/",
    "package.json",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "start": "node bin/cli.js",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "node bin/cli.js --json > /dev/null && node bin/cli.js --version && node bin/cli.js --help > /dev/null"
  },
  "keywords": [
    "ethereum",
    "wallet",
    "blockchain",
    "crypto",
    "cryptocurrency",
    "eth",
    "web3",
    "mnemonic",
    "bip39",
    "private-key",
    "address",
    "generator",
    "cli"
  ],
  "author": {
    "name": "Piotr Kowalski",
    "email": "piecioshka@gmail.com",
    "url": "https://piecioshka.pl/"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/piecioshka/ethereum-wallet-generator.git"
  },
  "bugs": {
    "url": "https://github.com/piecioshka/ethereum-wallet-generator/issues"
  },
  "homepage": "https://github.com/piecioshka/ethereum-wallet-generator#readme",
  "engines": {
    "node": ">=18.0.0"
  },
  "devDependencies": {
    "prettier": "^3.9.6"
  }
}
